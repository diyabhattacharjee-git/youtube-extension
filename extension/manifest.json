{
  "manifest_version": 3,
  "name": "TubeMind — YouTube to Mindmap",
  "short_name": "TubeMind",
  "version": "1.0.0",
  "description": "Turn any YouTube video into an interactive, timestamp-linked, hand-drawn mindmap. Open source (MIT).",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TubeMind",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "tabs", "contextMenus"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://i.ytimg.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/youtube.js"],
      "css": ["content/youtube.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "commands": {
    "generate-mindmap": {
      "suggested_key": { "default": "Alt+M" },
      "description": "Generate a mindmap for the current YouTube video"
    }
  }
}
